# 키움 REST API (https://openapi.kiwoom.com 에서 신청, 접속 IP 등록 필요)
KIWOOM_PAPER_APP_KEY=
KIWOOM_PAPER_APP_SECRET=
KIWOOM_PAPER_ACCOUNT_NO=
KIWOOM_REAL_APP_KEY=
KIWOOM_REAL_APP_SECRET=
KIWOOM_REAL_ACCOUNT_NO=

# 주문 모드: paper(모의투자) | real(실전). 시세 수집은 항상 실전 키(조회 전용)를 사용한다.
TRADING_MODE=paper

# DART 오픈API (https://opendart.fss.or.kr)
DART_API_KEY=

# 데이터 저장 위치 (기본: ./data/lake)
DATA_DIR=
